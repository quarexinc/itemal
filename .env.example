# ===== itemal yapılandırması =====
# Bu dosyayı kimseyle paylaşma ve GitHub'a yükleme.

# Yönetici (admin) giriş bilgileri -> /admin/giris
# Önerilen: şifreyi hash olarak sakla. `python manage.py hash-admin` komutu ADMIN_PASSWORD_HASH yazar ve düz metni siler.
# Kurulum kolaylığı için düz metin ADMIN_PASSWORD de çalışır (açılışta bellekte hash'lenir) ama önerilmez.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=guclu-bir-sifre-yaz-en-az-12-karakter
# ADMIN_PASSWORD_HASH=

# Yönetici girişi güvenliği (ayrıntı: docs/SECURITY.md)
# İki adımlı doğrulama (TOTP): required (varsayılan; ilk girişte zorunlu kurulum) | optional | off (yalnızca acil durum)
# ADMIN_2FA=required
# Yalnızca bu IP/CIDR'ler /admin'e erişir (diğerleri 404 alır). Proxy arkasında TRUST_PROXY=1 gerekir.
# ADMIN_ALLOWED_IPS=203.0.113.5,10.0.0.0/8
# Yönetim yolunu değiştir (varsayılan /admin)
# ADMIN_URL_PREFIX=/yonetim-x7
# 1: yönetici oturumu istemcinin /24 ağına bağlanır
# ADMIN_BIND_IP=0

# Oturum çerezlerini imzalamak için gizli anahtar (değiştirirsen herkes çıkış yapar)
SECRET_KEY=uzun-rastgele-bir-deger

# Ödeme sağlayıcısının /api/webhook/odeme adresine gönderdiği isteği imzalarken kullandığı ortak gizli anahtar
PAYMENT_WEBHOOK_SECRET=uzun-rastgele-bir-deger

# Kullanıcı bilgilerinin tutulduğu SQLite veritabanı dosyası
DATABASE_PATH=data/epin.db

# 1 = her başlangıçta HTML şablonlarını yeniden üret, 0 = mevcut dosyalara dokunma (elle düzenleme yapacaksan 0 yap)
REGENERATE_TEMPLATES=1

# Çerez güvenliği: auto = HTTPS isteklerinde Secure + __Host- önekli çerez (önerilen), 1 = her zaman, 0 = hiç
# Proxy (nginx vb.) arkasındaysan TRUST_PROXY=1 de ekle ki HTTPS doğru algılansın.
COOKIE_SECURE=auto
# TRUST_PROXY=1

# CORS: varsayılan KAPALI. /api/v1 uçlarına tarayıcıdan erişecek dış siteler varsa virgülle yaz.
# CORS_ORIGINS=https://panel.example.com
# Proxy arkasında Host başlığı farklı görünüyorsa kendi genel adresini yaz (Origin denetimi için):
# TRUSTED_ORIGINS=https://siten.example.com

# Sunucu
HOST=127.0.0.1
PORT=5000
DEBUG=0

# ===== Vercel / Turso (Vercel panelinde Environment Variables olarak gir) =====
# Turso veritabani (Vercel'de yerel SQLite kalici degildir). turso db create itemal ; turso db show itemal --url ; turso db tokens create itemal
# TURSO_DATABASE_URL=libsql://itemal-kullanici.turso.io
# TURSO_AUTH_TOKEN=
# Vercel Cron (/cron/gunluk) cagrisini dogrular; Vercel bunu otomatik "Authorization: Bearer <deger>" olarak gonderir
# CRON_SECRET=uzun-rastgele-bir-deger
# AUTO_DEMO=0
